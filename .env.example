# Firebase web app config — copiar a .env.local y completar con los valores del proyecto
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Poner en "true" para conectar a los emuladores locales (firebase emulators:start)
VITE_USE_FIREBASE_EMULATOR=false

# Login con Google. Dejar en "false" si los accesos son claves internas tipo usuario@gimnasio.com
VITE_ENABLE_GOOGLE_LOGIN=false

# App Check (reCAPTCHA v3): clave de sitio para atestar que las requests vienen
# de la app real. Sin esto, App Check no se inicializa. Crear la key en:
# consola Firebase → App Check → Apps → reCAPTCHA v3.
VITE_RECAPTCHA_V3_SITE_KEY=
# Solo desarrollo/CI: token de debug para App Check (consola → App Check → Debug
# tokens). "true" imprime uno nuevo en consola del navegador; o pegar uno fijo.
# NUNCA setear en producción.
# VITE_APPCHECK_DEBUG_TOKEN=true

# Modo demo (datos en memoria, sin Firebase). Debe ser explícito: si no está en
# "true" y faltan credenciales, la app falla al iniciar (no cae a demo sola).
# VITE_DEMO_MODE=true
