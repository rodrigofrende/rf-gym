rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Super-admin de la plataforma: custom claim seteado vía Admin SDK
    // (scripts/set-super-admin.mjs). El claim viaja firmado en el token, así que
    // no hay identidad hardcodeada acá ni en el bundle del cliente.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    function gymDoc(gymId) {
      return get(/databases/$(database)/documents/gyms/$(gymId));
    }

    function gymAdminUids(gymId) {
      return gymDoc(gymId).data.get('adminUids', []);
    }

    function userGymMembership(gymId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/gymMemberships/$(gymId));
    }

    function isGymAdmin(gymId) {
      return isSuperAdmin()
        || (isSignedIn() && request.auth.uid in gymAdminUids(gymId))
        || (isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/gymMemberships/$(gymId))
          && userGymMembership(gymId).data.role == 'admin');
    }

    function isGymMember(gymId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/gymMemberships/$(gymId));
    }

    function canAccessGym(gymId) {
      return isGymAdmin(gymId) || isGymMember(gymId);
    }

    // Data URL de imagen: valida header + size sin regex sobre el payload base64
    // (strings de 100–150KB con `.matches('...base64,.*')` pueden denegar la rule).
    function isDataImageUrl(s, maxSize) {
      return s is string
        && s.size() > 0
        && s.size() <= maxSize
        && s.split(',').size() == 2
        && s.split(',')[0] in [
          'data:image/png;base64',
          'data:image/jpeg;base64',
          'data:image/webp;base64'
        ];
    }

    function isHttpUrl(s, maxSize) {
      return s is string
        && s.size() > 0
        && s.size() <= maxSize
        && s.matches('https?://.*');
    }

    function isClaimingMembership() {
      return isSignedIn()
        && resource.data.uid == ''
        && resource.data.email == request.auth.token.email
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']);
    }

    // photoURL editable por el socio: solo si no cambia, o si el nuevo valor es
    // un data URL de imagen acotado o una URL http(s) corta. Evita que por API
    // directa se meta un payload gigante (DoS de doc) o un esquema peligroso.
    function selfPhotoUrlOk() {
      let d = request.resource.data;
      return !d.diff(resource.data).affectedKeys().hasAny(['photoURL'])
        || !('photoURL' in d)
        || isDataImageUrl(d.photoURL, 153600)
        || isHttpUrl(d.photoURL, 500);
    }

    function isSelfProfileEdit() {
      return isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phone', 'birthDate', 'photoURL'])
        && selfPhotoUrlOk();
    }

    function isSelfAuthStatusUpdate() {
      return isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['authStatus', 'passwordUpdatedAt', 'passwordResetRequestedAt']);
    }

    // ---- Perfil global ----
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSignedIn() && request.auth.uid == uid;

      match /gymMemberships/{gymId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        // El propio usuario solo puede escribir su índice de membresía si refleja
        // fielmente un member doc que ya reclamó: mismo uid y MISMO role. El role
        // lo controla exclusivamente un admin (las ramas self-edit del member no
        // tocan `role`), así que esto impide auto-asignarse `role: 'admin'`.
        allow write: if isSuperAdmin()
          || isGymAdmin(gymId)
          || (isSignedIn()
              && request.auth.uid == uid
              && request.resource.data.keys().hasOnly(['memberId', 'role'])
              && exists(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.resource.data.memberId))
              && get(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.resource.data.memberId)).data.uid == request.auth.uid
              && get(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.resource.data.memberId)).data.role == request.resource.data.role);
      }
    }

    // ---- Planes de suscripción (catálogo de la plataforma) ----
    // Lectura pública: la landing de marketing muestra los precios en vivo.
    // Catálogo comercial sin PII; escribe solo el super-admin.
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Índice de lookup por email para el login (legible sin auth para poder rutear
    // el flujo antes de autenticar). Como es world-readable, la forma se valida en
    // escritura para que NO contenga PII de más (nombre completo, rol): solo lo
    // mínimo que el login necesita.
    match /memberLoginIndex/{emailKey} {
      function validLoginIndex() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'gymId', 'gymName', 'memberId'])
          && (!('email' in d) || (d.email is string && d.email.size() <= 200))
          && (!('gymId' in d) || (d.gymId is string && d.gymId.size() <= 200))
          && (!('gymName' in d) || (d.gymName is string && d.gymName.size() <= 120))
          && (!('memberId' in d) || (d.memberId is string && d.memberId.size() <= 200));
      }
      // La clave del doc DEBE ser el email (normalizado) que declara el payload:
      // impide que un admin escriba/reapunte el índice de un email ajeno
      // (envenenamiento cross-tenant del ruteo de login).
      function keyMatchesEmail() {
        return 'email' in request.resource.data
          && emailKey == request.resource.data.email.lower();
      }
      allow get: if true;
      allow list: if false;
      allow create, update: if validLoginIndex()
        && keyMatchesEmail()
        // No re-apuntar un índice existente a otro gym.
        && (resource == null || resource.data.gymId == request.resource.data.gymId)
        && (isGymAdmin(request.resource.data.gymId)
          || (isSignedIn()
            && get(/databases/$(database)/documents/gyms/$(request.resource.data.gymId)/members/$(request.resource.data.memberId)).data.uid == request.auth.uid));
      allow delete: if isGymAdmin(resource.data.gymId);
    }

    // ---- Presentación pública del gym (para prospectos, sin login) ----
    // Legible por cualquiera; escribible solo por admin del gym o super-admin.
    // NO contiene datos sensibles: snapshot de marca + datos de contacto públicos.
    // Como es de lectura pública, validamos forma y tamaños para que un admin no
    // pueda escribir campos arbitrarios ni payloads enormes en un doc world-readable.
    match /publicProfiles/{gymId} {
      // Un sponsor válido: shape acotado (el doc es world-readable). Solo el
      // nombre es obligatorio; la imagen es un data URL chico (mismo pipeline
      // que el logo, tope espejado en utils/image.ts) o una URL http(s).
      // Los campos legacy (tier/logoURL/instagram/whatsapp/youtubeURL) se
      // aceptan acotados para no bloquear re-escrituras de docs viejos.
      function validSponsor(s) {
        return (s is map)
          && s.keys().hasOnly([
              'name', 'imageURL', 'phone', 'linkURL',
              'tier', 'logoURL', 'instagram', 'whatsapp', 'youtubeURL'
            ])
          && ('name' in s && s.name is string && s.name.size() >= 1 && s.name.size() <= 80)
          && (!('imageURL' in s) || isDataImageUrl(s.imageURL, 102400) || isHttpUrl(s.imageURL, 102400))
          && (!('phone' in s) || (s.phone is string && s.phone.size() <= 40))
          && (!('linkURL' in s) || isHttpUrl(s.linkURL, 300))
          && (!('tier' in s) || (s.tier is string && s.tier.size() <= 20))
          && (!('logoURL' in s) || (s.logoURL is string && s.logoURL.size() <= 500))
          && (!('instagram' in s) || (s.instagram is string && s.instagram.size() <= 120))
          && (!('whatsapp' in s) || (s.whatsapp is string && s.whatsapp.size() <= 40))
          && (!('youtubeURL' in s) || (s.youtubeURL is string && s.youtubeURL.size() <= 300));
      }
      // Las rules no tienen loops: con tope 6 (los que entran en pantalla,
      // espejado en SponsorsPage), se valida cada índice a mano.
      function validSponsors(list) {
        return list.size() <= 6
          && (list.size() < 1 || validSponsor(list[0]))
          && (list.size() < 2 || validSponsor(list[1]))
          && (list.size() < 3 || validSponsor(list[2]))
          && (list.size() < 4 || validSponsor(list[3]))
          && (list.size() < 5 || validSponsor(list[4]))
          && (list.size() < 6 || validSponsor(list[5]));
      }
      function validPresentation() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'id', 'name', 'logoURL', 'theme', 'description', 'videos', 'links', 'tariffs', 'sponsors',
            'sponsorsWindowStart', 'sponsorsChangeCount',
            'whatsapp', 'email', 'address', 'openingHours',
            'videoURL', 'instagramURL', 'facebookURL', 'updatedAt'
          ])
          && (!('name' in d) || (d.name is string && d.name.size() <= 120))
          && (!('description' in d) || (d.description is string && d.description.size() <= 2000))
          && (!('videos' in d) || (d.videos is list && d.videos.size() <= 6))
          && (!('links' in d) || (d.links is list && d.links.size() <= 12))
          && (!('tariffs' in d) || (d.tariffs is list && d.tariffs.size() <= 20))
          && (!('sponsors' in d) || (d.sponsors is list && validSponsors(d.sponsors)))
          && (!('sponsorsChangeCount' in d) || d.sponsorsChangeCount is int)
          && (!('sponsorsWindowStart' in d) || d.sponsorsWindowStart is timestamp)
          && (!('whatsapp' in d) || (d.whatsapp is string && d.whatsapp.size() <= 40))
          && (!('email' in d) || (d.email is string && d.email.size() <= 200))
          && (!('address' in d) || (d.address is string && d.address.size() <= 200))
          && (!('openingHours' in d) || (d.openingHours is string && d.openingHours.size() <= 200))
          && (!('logoURL' in d) || isDataImageUrl(d.logoURL, 153600));
      }
      // El logo del perfil público debe reflejar el de `gyms/{gymId}` (que ya está
      // rate-limiteado). Así el mirror world-readable hereda el límite sin duplicar
      // contadores, y no puede divergir del logo real.
      function logoMirrorsGym() {
        let d = request.resource.data;
        return !('logoURL' in d)
          || (resource != null && !d.diff(resource.data).affectedKeys().hasAny(['logoURL']))
          || (exists(/databases/$(database)/documents/gyms/$(gymId))
              && d.logoURL == gymDoc(gymId).data.get('logoURL', null));
      }
      // Rate-limit de cambios de sponsors: máximo 5 por ventana fija de 24hs
      // (mismo esquema que el logo en gyms/logoLimitOk, espejado en SponsorsPage).
      // El cliente manda sponsorsWindowStart (serverTimestamp) + sponsorsChangeCount
      // solo cuando la lista realmente cambió.
      function sponsorsLimitOnCreate() {
        let d = request.resource.data;
        return !('sponsors' in d) || d.sponsors.size() == 0
          || (d.get('sponsorsWindowStart', null) == request.time
            && d.get('sponsorsChangeCount', 99) == 1);
      }
      function sponsorsLimitOnUpdate() {
        let d = request.resource.data;
        return !d.diff(resource.data).affectedKeys().hasAny(['sponsors'])
          || (
            // Ventana nueva: primera vez o la anterior ya venció.
            (d.get('sponsorsWindowStart', null) == request.time
              && d.get('sponsorsChangeCount', 99) == 1
              && (!('sponsorsWindowStart' in resource.data)
                || resource.data.sponsorsWindowStart + duration.value(24, 'h') < request.time))
            ||
            // Misma ventana: suma exactamente 1, hasta 5.
            (d.get('sponsorsWindowStart', null) == resource.data.get('sponsorsWindowStart', null)
              && d.get('sponsorsChangeCount', 99) == resource.data.get('sponsorsChangeCount', 0) + 1
              && d.get('sponsorsChangeCount', 99) <= 5)
          );
      }
      allow read: if true;
      allow create: if isGymAdmin(gymId) && validPresentation() && logoMirrorsGym() && sponsorsLimitOnCreate();
      allow update: if isGymAdmin(gymId) && validPresentation() && logoMirrorsGym() && sponsorsLimitOnUpdate();
      allow delete: if isGymAdmin(gymId);
    }

    match /gyms/{gymId} {
      // Rate-limit del logo: máximo 3 cambios por ventana fija de 24hs, y tope de
      // tamaño del data URL (el logo se guarda inline como string en el doc).
      // El cliente manda logoWindowStart (serverTimestamp) + logoChangeCount.
      function logoLimitOk() {
        let d = request.resource.data;
        return !d.diff(resource.data).affectedKeys().hasAny(['logoURL'])
          || (
            (!('logoURL' in d) || isDataImageUrl(d.logoURL, 153600))
            && (
              // Ventana nueva: primera vez o la anterior ya venció.
              (d.get('logoWindowStart', null) == request.time
                && d.get('logoChangeCount', 99) == 1
                && (!('logoWindowStart' in resource.data)
                  || resource.data.logoWindowStart + duration.value(24, 'h') < request.time))
              ||
              // Misma ventana: suma exactamente 1, hasta 3.
              (d.get('logoWindowStart', null) == resource.data.get('logoWindowStart', null)
                && d.get('logoChangeCount', 99) == resource.data.get('logoChangeCount', 0) + 1
                && d.get('logoChangeCount', 99) <= 3)
            )
          );
      }

      // Un admin NO puede tocar la facturación ni la propiedad del gym: el plan,
      // la cuota y el estado de suscripción (subscription) y el dueño (ownerUid)
      // los gestiona SOLO el super-admin. Sin esto, un admin podría auto-asignarse
      // el plan premium o marcar su suscripción como paga.
      function adminSafeGymUpdate() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['subscription', 'ownerUid']);
      }

      allow read: if canAccessGym(gymId) || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isGymAdmin(gymId) && logoLimitOk() && adminSafeGymUpdate());
      allow delete: if isSuperAdmin();

      // ---- Socios / membresías ----
      match /members/{memberId} {
        allow read: if isGymAdmin(gymId)
          || (isSignedIn() && resource.data.uid == request.auth.uid)
          || (isSignedIn() && resource.data.email == request.auth.token.email);

        allow create, delete: if isGymAdmin(gymId);

        allow update: if isGymAdmin(gymId)
          || isClaimingMembership()
          || isSelfProfileEdit()
          || isSelfAuthStatusUpdate();

        match /notes/{noteId} {
          allow read, write: if isGymAdmin(gymId);
        }

        match /logs/{logId} {
          // Registro de carga del socio. Doc world-readable solo para admin +
          // dueño, pero como lo escribe el propio socio validamos forma y tamaño
          // para que por API directa no se puedan inyectar payloads enormes.
          function validLog() {
            let d = request.resource.data;
            return d.keys().hasOnly([
                'routineId', 'exerciseKey', 'exerciseName', 'dayKey',
                'trainingDate', 'date', 'sets'
              ])
              && d.routineId is string && d.routineId.size() <= 200
              && d.exerciseName is string && d.exerciseName.size() >= 1 && d.exerciseName.size() <= 160
              && (!('exerciseKey' in d) || (d.exerciseKey is string && d.exerciseKey.size() <= 200))
              && (!('dayKey' in d) || (d.dayKey is string && d.dayKey.size() <= 40))
              && d.sets is list && d.sets.size() <= 60;
          }
          function isLogOwner() {
            return get(/databases/$(database)/documents/gyms/$(gymId)/members/$(memberId)).data.uid == request.auth.uid;
          }
          allow read: if isGymAdmin(gymId) || isLogOwner();
          allow create, update: if isLogOwner() && validLog();
          allow delete: if isLogOwner();
        }

        match /payments/{paymentId} {
          allow read: if isGymAdmin(gymId)
            || (isSignedIn() && get(/databases/$(database)/documents/gyms/$(gymId)/members/$(memberId)).data.uid == request.auth.uid);
          allow write: if isGymAdmin(gymId);
        }
      }

      match /tariffs/{tariffId} {
        allow read: if canAccessGym(gymId);
        allow write: if isGymAdmin(gymId);
      }

      match /products/{productId} {
        // El doc lleva la foto inline (~150KB, tope espejado en utils/image.ts),
        // así que se valida forma y tamaño igual que el logo del gym.
        function validProduct() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'description', 'photoURL', 'price', 'discountPct', 'available'])
            && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
            && d.description is string && d.description.size() >= 1 && d.description.size() <= 500
            && isDataImageUrl(d.photoURL, 153600)
            && d.price is int && d.price > 0
            && d.discountPct is int && d.discountPct >= 0 && d.discountPct <= 100
            && d.available is bool;
        }
        allow read: if canAccessGym(gymId);
        allow create, update: if isGymAdmin(gymId) && validProduct();
        allow delete: if isGymAdmin(gymId);
      }

      match /routines/{routineId} {
        allow read: if canAccessGym(gymId);
        allow write: if isGymAdmin(gymId);
      }

      match /exercises/{exerciseId} {
        allow read: if canAccessGym(gymId);
        allow write: if isGymAdmin(gymId);
      }

      match /assignments/{assignmentId} {
        allow read: if canAccessGym(gymId);
        allow write: if isGymAdmin(gymId);
      }

      match /attendance/{attendanceId} {
        function validAttendance() {
          let d = request.resource.data;
          return d.keys().hasOnly([
              'memberId', 'memberUid', 'memberName', 'email',
              'dayKey', 'checkedInAt', 'lastSeenAt', 'scanCount', 'paymentState', 'memberStatus'
            ])
            && d.memberId is string && d.memberId.size() <= 200
            && d.memberUid == request.auth.uid
            && d.dayKey is string && d.dayKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && d.scanCount is int && d.scanCount >= 1 && d.scanCount <= 5000
            && (!('memberName' in d) || (d.memberName is string && d.memberName.size() <= 160))
            && (!('email' in d) || (d.email is string && d.email.size() <= 200))
            && (!('paymentState' in d) || (d.paymentState is string && d.paymentState.size() <= 20))
            && (!('memberStatus' in d) || (d.memberStatus is string && d.memberStatus.size() <= 20))
            && (!('checkedInAt' in d) || d.checkedInAt is timestamp)
            && (!('lastSeenAt' in d) || d.lastSeenAt is timestamp);
        }
        // Ata el doc-id a (dayKey, memberId): un doc por día por socio; no se puede
        // sobrescribir la asistencia de otro ni desdoblar el día.
        function attendanceIdBound() {
          return attendanceId == request.resource.data.dayKey + '_' + request.resource.data.memberId;
        }
        // El socio referenciado por memberId es el propio (uid del token).
        function isOwnAttendanceWrite() {
          return isSignedIn()
            && request.resource.data.memberUid == request.auth.uid
            && exists(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.resource.data.memberId))
            && get(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.resource.data.memberId)).data.uid == request.auth.uid;
        }
        allow get: if isGymAdmin(gymId)
          || (isSignedIn()
            && exists(/databases/$(database)/documents/gyms/$(gymId)/attendance/$(attendanceId))
            && resource.data.memberUid == request.auth.uid)
          || (isSignedIn()
            && !exists(/databases/$(database)/documents/gyms/$(gymId)/attendance/$(attendanceId))
            && isGymMember(gymId));
        allow list: if isGymAdmin(gymId);
        allow create: if isOwnAttendanceWrite() && validAttendance() && attendanceIdBound()
          && request.resource.data.scanCount == 1;
        // Re-scan del mismo día: solo cambia contadores; día y socio quedan fijos.
        allow update: if isOwnAttendanceWrite() && validAttendance() && attendanceIdBound()
          && request.resource.data.dayKey == resource.data.dayKey
          && request.resource.data.memberId == resource.data.memberId;
      }

      // Ranking mensual de asistencia. Legible por todo el gym (admin + socios),
      // por eso el doc NO lleva datos sensibles: solo nombre enmascarado
      // ("Rodrigo F.") y el contador de días. Lo escribe el propio socio al hacer
      // check-in (incremento de a 1 validado: increment() se aplica ANTES de
      // evaluar las rules) o el admin (recompute con cualquier valor).
      match /attendanceMonthly/{entryId} {
        function validMonthly() {
          let d = request.resource.data;
          return d.keys().hasOnly(['monthKey', 'memberId', 'memberUid', 'displayName', 'days', 'lastDay'])
            && d.monthKey is string && d.monthKey.matches('[0-9]{4}-[0-9]{2}')
            && d.memberId is string && d.memberId.size() <= 200
            && d.memberUid is string && d.memberUid.size() <= 128
            && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 40
            // Tope 31 = máximo de días de un mes. Acota el inflado del ranking vía
            // API directa (nadie puede mostrar más días que los que tiene el mes).
            && d.days is int && d.days >= 1 && d.days <= 31
            && (!('lastDay' in d) || (d.lastDay is string && d.lastDay.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
        }
        // Identidad como en attendance: el doc referencia un member reclamado por este uid.
        function isOwnMonthly() {
          return isSignedIn()
            && request.resource.data.memberUid == request.auth.uid
            && exists(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.resource.data.memberId))
            && get(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.resource.data.memberId)).data.uid == request.auth.uid;
        }
        // El socio solo cuenta un día por el que EXISTE su asistencia real de ese
        // día (doc atado en /attendance) → no puede sumar días que no fue.
        function ownDayHasAttendance() {
          return 'lastDay' in request.resource.data
            && exists(/databases/$(database)/documents/gyms/$(gymId)/attendance/$(request.resource.data.lastDay + '_' + request.resource.data.memberId));
        }
        allow get, list: if canAccessGym(gymId);
        allow create: if validMonthly()
          && (isGymAdmin(gymId)
            || (isOwnMonthly() && request.resource.data.days == 1 && ownDayHasAttendance()));
        // Update propio: +1, con asistencia real de ese día y SOLO hacia adelante
        // (lastDay creciente) → no se puede recontar un día ni inflar el contador.
        allow update: if validMonthly()
          && (isGymAdmin(gymId)
            || (isOwnMonthly()
                && request.resource.data.days == resource.data.days + 1
                && ownDayHasAttendance()
                && request.resource.data.lastDay > resource.data.get('lastDay', '')));
        allow delete: if isGymAdmin(gymId);
      }

      match /payments/{paymentId} {
        allow read: if isGymAdmin(gymId) || isSuperAdmin();
        allow write: if isSuperAdmin();
      }

      match /stats/{docId} {
        allow read, write: if isGymAdmin(gymId);
      }
    }
  }
}
